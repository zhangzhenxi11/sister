    "@qdrant/js-client-rest": "^1.16.0",
    "@types/pdf-parse": "^1.1.5",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.21.2",
    "fluent-ffmpeg": "^2.1.3",
    "js-yaml": "^4.3.2",
    "lucide-react": "^0.511.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.77.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.3.0",
